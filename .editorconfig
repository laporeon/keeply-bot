# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
max_line_length = 120
# IntelliJ-specific (ignored by other editors)
ij_continuation_indent_size = 8

[*.xml]
indent_size = 2

[*.{json,yml,yaml,properties}]
indent_size = 2

[*.md]
# Trailing double space is a line break in Markdown
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab